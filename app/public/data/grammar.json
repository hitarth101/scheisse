{"source":"Nicos Weg (DW): lesson and topic names and links only. Grimm Grammar (UT Austin) and Schubert-Verlag: links only. Tables: Wiktionary (CC BY-SA 4.0) via kaikki.org.","lessons":[],"topics":[],"tables":[{"id":"definite-articles","title":"Definite articles","sub":"“the”, by case","group":"Articles and pronouns","sections":[{"columns":["Masc.","Fem.","Neut.","Plural"],"gender":true,"rows":[{"name":"Nominative","cells":["der","die","das","die"]},{"name":"Accusative","cells":["den","die","das","die"]},{"name":"Dative","cells":["dem","der","dem","den"]},{"name":"Genitive","cells":["des","der","des","der"]}]}],"source":"Wiktionary: der"},{"id":"indefinite-articles","title":"Indefinite articles","sub":"“a, an”, by case","group":"Articles and pronouns","sections":[{"columns":["Masc.","Fem.","Neut.","Plural"],"gender":true,"rows":[{"name":"Nominative","cells":["ein","eine","ein",null]},{"name":"Accusative","cells":["einen","eine","ein",null]},{"name":"Dative","cells":["einem","einer","einem",null]},{"name":"Genitive","cells":["eines","einer","eines",null]}]}],"foot":"There is no plural form.","source":"Wiktionary: ein"},{"id":"personal-pronouns","title":"Personal pronouns","sub":"by case","group":"Articles and pronouns","sections":[{"columns":["Nominative","Accusative","Dative"],"nameLang":"en","rows":[{"name":"I","cells":["ich","mich","mir"]},{"name":"you","cells":["du","dich","dir"]},{"name":"he","cells":["er","ihn","ihm"]},{"name":"she","cells":["sie","sie","ihr"]},{"name":"it","cells":["es","es","ihm"]},{"name":"we","cells":["wir","uns","uns"]},{"name":"you all","cells":["ihr","euch","euch"]},{"name":"they","cells":["sie","sie","ihnen"]},{"name":"you (formal)","cells":["Sie","Sie","Ihnen"]}]}],"source":"Wiktionary: ich (personal pronoun table)"},{"id":"possessives","title":"Possessive words","sub":"“my”, “your”…","group":"Articles and pronouns","sections":[{"title":"mein, by case","columns":["Masc.","Fem.","Neut.","Plural"],"gender":true,"rows":[{"name":"Nominati
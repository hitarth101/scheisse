ative","cells":["einen guten","eine gute","ein gutes","keine guten"]},{"name":"Dative","cells":["einem guten","einer guten","einem guten","keinen guten"]},{"name":"Genitive","cells":["eines guten","einer guten","eines guten","keiner guten"]}]},{"title":"No article","columns":["Masc.","Fem.","Neut.","Plural"],"gender":true,"rows":[{"name":"Nominative","cells":["guter","gute","gutes","gute"]},{"name":"Accusative","cells":["guten","gute","gutes","gute"]},{"name":"Dative","cells":["gutem","guter","gutem","guten"]},{"name":"Genitive","cells":["guten","guter","guten","guter"]}]}],"source":"Wiktionary: gut (declension table)"},{"id":"present-tense","title":"Present tense","sub":"sein, haben, werden and the modal verbs","group":"Verbs","sections":[{"columns":["sein","haben","werden"],"nameLang":"de","rows":[{"name":"ich","cells":["bin","habe","werde"]},{"name":"du","cells":["bist","hast","wirst"]},{"name":"er/sie/es","cells":["ist","hat","wird"]},{"name":"wir","cells":["sind","haben","werden"]},{"name":"ihr","cells":["seid","habt","werdet"]},{"name":"sie/Sie","cells":["sind","haben","werden"]}]},{"title":"Modal verbs","columns":["können","müssen","dürfen"],"nameLang":"de","rows":[{"name":"ich","cells":["kann","muss","darf"]},{"name":"du","cells":["kannst","musst","darfst"]},{"name":"er/sie/es","cells":["kann","muss","darf"]},{"name":"wir","cells":["können","müssen","dürfen"]},{"name":"ihr","cells":["könnt","müsst","dürft"]},{"name":"sie/Sie","cells":["können","müssen","dürfen"]}]},{"columns":["sollen","wollen","mögen"],"nameLang":"de","rows":[{"name":"ich","cells":["soll","will","mag"]},{"name":"du","cells":["sollst","willst","magst"]},{"name":"er/sie/es","cells":["soll","will","mag"]},{"name":"wir","cells":["sollen","wollen","mögen"]},{"name":"ihr","cells":["sollt","wollt","mögt"]},{"name":"sie/Sie","cells":["sollen","wollen","mögen"]}]}],"source":"Wiktionary: sein, haben, werden, können, müssen, dürfen, sollen, wollen, mögen"}]}
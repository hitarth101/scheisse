      "speakerEn": "Assistant",
      "de": [
        "Auskunft, guten Tag."
      ],
      "en": [
        "Directory assistance, hello."
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Guten Tag.",
        "Ich hätte gerne die Telefonnummer von Frau Claudia Bolliger aus Bern."
      ],
      "enPara": "Hello, I would like to have the phone number of Mrs. Claudia Bolliger from Berne."
    },
    {
      "speaker": "Auskunft",
      "speakerEn": "Assistant",
      "de": [
        "Wie schreibt man das?",
        "Bitte buchstabieren Sie."
      ],
      "en": [
        "How do you write the name?",
        "Please spell it."
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Natürlich.",
        "Claudia: C wie Cäsar, L wie Ludwig, A wie Anton, U wie Ursula, D wie Dora, I wie Ida, A wie Anton.",
        "Bolliger: B wie Berta, O wie Otto, zweimal L wie Ludwig, I wie Ida, G wie Gustav, E wie Emil und R wie Richard."
      ],
      "enPara": "Of course. Claudia: C as in Cäsar, L as in Ludwig, A as in Anton, ..."
    },
    {
      "speaker": "Auskunft",
      "speakerEn": "Assistant",
      "de": [
        "Danke.",
        "Die Nummer lautet ..."

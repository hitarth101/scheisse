  "paragraphs": [
    {
      "speaker": "Franz",
      "de": [
        "Hallo, ich bin Franz.",
        "Wie heißt du?"
      ],
      "en": [
        "Hello, I am Franz.",
        "What is your name?"
      ]
    },
    {
      "speaker": "Greta",
      "de": [
        "Hallo, Franz.",
        "Ich heiße Greta.",
        "Wie geht's?"
      ],
      "en": [
        "Hello, Franz.",
        "My name is Greta.",
        "How is it going?"
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Es geht mir gut.",
        "Kennst du den Lehrer?"
      ],
      "en": [
        "I'm good.",
        "Do you know the teacher?"
      ]
    },
    {
      "speaker": "Greta",
      "de": [
        "Ja, er heißt Herr Weiß."
      ],
      "en": [
        "Yes, his name is Mr. Weiß."
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Oh, danke, Greta.",
        "Bis dann!"
      ],
      "en": [
        "Oh, thanks, Greta.",
        "See you!"
      ]
    },
    {
      "speaker": "Greta",
      "de": [
        "Wiedersehen!"
      ],
      "en": [
        "Goodbye!"
      ]
    }
  ]
}

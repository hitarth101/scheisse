  "paragraphs": [
    {
      "speaker": "Franz",
      "de": [
        "Guten Morgen.",
        "Sind Sie Herr Weiß?"
      ],
      "en": [
        "Good morning.",
        "Are you Mr. Weiß?"
      ]
    },
    {
      "speaker": "Herr Schwarz",
      "speakerEn": "Mr. Schwarz",
      "de": [
        "Nein, ich bin Herr Schwarz.",
        "Wie heißt du?"
      ],
      "en": [
        "No, I'm Mr. Schwarz.",
        "What's your name?"
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Ich heiße Franz.",
        "Danke, Herr Schwarz.",
        "Ich bin spät dran."
      ],
      "en": [
        "My name's Franz.",
        "Thank you, Mr. Schwarz.",
        "I'm late."
      ]
    },
    {
      "speaker": "Herr Schwarz",
      "speakerEn": "Mr. Schwarz",
      "de": [
        "Bitte, Franz.",
        "Ich bin auch spät dran.",
        "Bis später!"
      ],
      "en": [
        "You're welcome, Franz.",
        "I'm also late.",
        "See you!"
      ]
    },
    {
      "speaker": "Franz",
      "de": [
        "Auf Wiedersehen!"
      ],
      "en": [
        "Goodbye!"
      ]
    }
  ]
}
